{
  "name": "chinese-chess-demo",
  "version": "0.5.8",
  "description": "中国象棋：网页、Windows 客户端与局域网对弈",
  "private": true,
  "author": "Winston112358",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/desktop/main.js",
  "scripts": {
    "start": "node src/server/start.js",
    "desktop": "electron .",
    "test": "node --test",
    "benchmark": "node scripts/benchmark_rules.js",
    "setup:ai": "node scripts/setup-ai.js",
    "dist:win": "npm run setup:ai && electron-builder --win portable --x64"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Winston112358/Chinese-Chess-Demo.git"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.winston112358.chinesechess",
    "productName": "Chinese Chess Demo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "web/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/pikafish",
        "to": "pikafish",
        "filter": [
          "**/*"
        ]
      }
    ],
    "portable": {
      "unpackDirName": true
    },
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "Chinese-Chess-Demo-${version}-${arch}.${ext}"
    }
  }
}
